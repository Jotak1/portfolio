---
/**
 * Entry redirects to Expediente — the former home launcher was removed.
 * Halftone Drift lives on the Expediente page.
 */
const base = import.meta.env.BASE_URL;
const target = `${base}expediente/`;
---
<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Expediente · Juan Pablo Ausensi</title>
    <script define:vars={{ target }}>
      location.replace(target);
    </script>
    <style>
      :root {
        color-scheme: dark;
        --bg: oklch(14% 0.012 250);
        --fg: oklch(94% 0.01 95);
        --accent: oklch(78% 0.13 210);
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font: 15px / 1.5 system-ui, sans-serif;
      }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <p>Abriendo <a href={target}>Expediente</a>…</p>
  </body>
</html>
