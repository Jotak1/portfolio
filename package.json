{
  "name": "portfolio",
  "private": true,
  "homepage": "https://jotak1.github.io/portfolio",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "check": "bun run --cwd apps/web check",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d apps/web/dist --dotfiles"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.8.0"
  }
}
